:root {
    --bg-main: #0b111e;
    --bg-card: #131c2e;
    --bg-input: #1b263b;
    --border-color: #26354e;
    --text-primary: #ffffff;
    --text-secondary: #8fa0dd;
    --accent-blue: #2563eb;
    --accent-hover: #3b82f6;
    --pink-tag: #e0529c;
    --teal-tag: #2bbba1;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    padding: 20px;
    min-height: 100vh;
}

/* Header */
.main-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
}

.header-title h1 {
    font-size: 24px;
    font-weight: 700;
    display: inline-block;
}

.header-title span {
    color: var(--text-secondary);
    font-weight: 400;
    font-size: 18px;
    margin-left: 4px;
}

.user-badge {
    background: var(--bg-card);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 14px;
    color: var(--text-secondary);
    margin-left: 12px;
    border: 1px solid var(--border-color);
}

.flag-icon {
    font-size: 24px;
}

/* Dashboard Layout */
.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* Upload Section */
.drop-zone {
    background: var(--bg-card);
    border: 2px dashed var(--border-color);
    border-radius: 8px;
    padding: 30px;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s ease;
}

.drop-zone:hover {
    background: #162238;
    border-color: var(--accent-blue);
}

.drop-zone-content h3 {
    font-size: 18px;
    margin: 10px 0 5px 0;
}

.drop-zone-content p {
    color: var(--text-secondary);
    font-size: 14px;
}

.hint {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    color: #64748b;
}

.upload-icon {
    color: var(--text-secondary);
}

.file-info {
    background: #1e293b;
    padding: 10px;
    border-radius: 6px;
    margin-top: 10px;
    font-size: 14px;
    border-left: 4px solid var(--teal-tag);
}

/* Config Cards Grid */
.config-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

@media (max-width: 900px) {
    .config-grid {
        grid-template-columns: 1fr;
    }
}

.config-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
}

.config-card h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
}

.section-desc {
    color: var(--text-secondary);
    font-size: 13px;
    margin-bottom: 20px;
}

/* Forms & Inputs */
.mapping-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-group label {
    font-size: 14px;
    color: var(--text-primary);
}

select, input[type="text"], input[type="date"] {
    background: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    padding: 10px 12px;
    font-size: 14px;
    width: 100%;
    outline: none;
    transition: border 0.2s;
}

select:focus, input:focus {
    border-color: var(--accent-blue);
}

.help-text {
    font-size: 11px;
    color: #64748b;
}

/* Right Side Panel Layout */
.right-panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* Categories Section */
.categories-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.list-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 8px;
    display: block;
}

.categories-checklist {
    background: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 12px;
    max-height: 180px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.empty-notice {
    color: #64748b;
    font-size: 13px;
    text-align: center;
    padding: 20px 0;
}

.check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    cursor: pointer;
}

.check-item input[type="checkbox"] {
    accent-color: var(--pink-tag);
    width: 16px;
    height: 16px;
}

/* Buckets Design */
.buckets-config {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bucket-group {
    background: var(--bg-input);
    border-radius: 6px;
    padding: 12px;
    border-left: 4px solid transparent;
}

.row-bucket { border-left-color: var(--pink-tag); }
.others-bucket { border-left-color: var(--teal-tag); }

.bucket-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 8px;
}

.bucket-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.input-subgroup label {
    font-size: 11px;
    color: #64748b;
    display: block;
    margin-bottom: 4px;
}

.color-picker-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    height: 38px;
}

.color-picker-wrapper input[type="color"] {
    border: none;
    background: none;
    width: 24px;
    height: 24px;
    cursor: pointer;
}

.color-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* Extra Params Inline Card */
.params-inline-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
}

.action-wrapper {
    display: flex;
    justify-content: flex-end;
}

/* Button with Sparkle */
.btn-primary {
    background-color: var(--accent-blue);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
}

.btn-primary:hover {
    background-color: var(--accent-hover);
}

.hidden {
    display: none !important;
}
